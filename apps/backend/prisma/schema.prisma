generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoUsuario {
  MUSICO
  BANDA
  CONTRATANTE
  ADMIN
}

enum TipoArtista {
  MUSICO
  BANDA
}

enum TipoPortfolio {
  FOTO
  VIDEO
  AUDIO
  YOUTUBE
  OUTRO
}

enum TipoEvento {
  SHOW
  CASAMENTO
  FORMATURA
  ANIVERSARIO
  BAR
  RESTAURANTE
  CORPORATIVO
  RELIGIOSO
  FESTIVAL
  EVENTO_PUBLICO
  EVENTO_PRIVADO
  OUTRO
}

enum FuncaoIntegrante {
  VOCAL
  GUITARRA
  VIOLAO
  BAIXO
  BATERIA
  TECLADO
  PERCUSSAO
  SAXOFONE
  TROMPETE
  ACORDEON
  VIOLINO
  DJ
  PRODUTOR
  OUTRO
}

enum StatusSolicitacao {
  PENDENTE
  ACEITA
  RECUSADA
  CANCELADA
}

enum StatusAgenda {
  DISPONIVEL
  INDISPONIVEL
  PENDENTE
  RESERVADO
}

enum OrigemAgenda {
  ARTISTA
  CONTRATACAO
  ADMIN
}

enum TipoNotificacao {
  SOLICITACAO_CRIADA
  SOLICITACAO_ACEITA
  SOLICITACAO_RECUSADA
  SOLICITACAO_CANCELADA
  CONVERSA_SOLICITADA
  CONVERSA_ACEITA
  CONVERSA_RECUSADA
  MENSAGEM_RECEBIDA
}

enum StatusConversa {
  PENDENTE
  ACEITA
  RECUSADA
}

enum TipoDenuncia {
  SOLICITACAO
  ANUNCIO
  USUARIO
}

enum MotivoDenuncia {
  GOLPE
  CONTEUDO_INAPROPRIADO
  SPAM
  INFORMACAO_FALSA
  OUTRO
}

enum StatusDenuncia {
  PENDENTE
  EM_ANALISE
  RESOLVIDA
}

enum TipoAnuncio {
  VENDA
  COMPRA
  ALUGUEL
}

enum StatusAnuncio {
  ATIVO
  CONCLUIDO
  INATIVO
}

model Usuario {
  id             String      @id @db.Uuid
  nome           String      @db.VarChar(120)
  email          String      @unique @db.VarChar(255)
  telefone       String      @db.VarChar(20)
  whatsapp       String?     @db.VarChar(20)
  fotoUrl        String?     @db.VarChar(500)
  dataNascimento DateTime?
  tipo           TipoUsuario
  ativo          Boolean     @default(true)
  ultimoLoginEm  DateTime?
  criadoEm       DateTime    @default(now())
  atualizadoEm   DateTime    @updatedAt

  perfilArtista     PerfilArtista?
  perfilContratante PerfilContratante?

  solicitacoesEnviadas SolicitacaoContratacao[]
  notificacoes         Notificacao[]
  anuncios             Anuncio[]
  avaliacoesFeitas     Avaliacao[]
  denunciasFeitas      Denuncia[]

  conversasComoComprador Conversa[] @relation("ConversasComoComprador")
  conversasComoVendedor  Conversa[] @relation("ConversasComoVendedor")
  mensagensEnviadas      Mensagem[]

  @@index([tipo])
  @@index([ativo])
  @@index([ultimoLoginEm])
}

model Anuncio {
  id            String        @id @default(uuid()) @db.Uuid
  usuarioId     String        @db.Uuid
  tipo          TipoAnuncio
  titulo        String        @db.VarChar(160)
  descricao     String        @db.Text
  categoria     String        @db.VarChar(80)
  preco         Decimal?      @db.Decimal(10, 2)
  cidade        String        @db.VarChar(120)
  estado        String        @db.VarChar(2)
  fotos         String[]
  status        StatusAnuncio @default(ATIVO)
  visualizacoes Int           @default(0)
  criadoEm      DateTime      @default(now())
  atualizadoEm  DateTime      @updatedAt

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  conversas Conversa[]

  @@index([tipo])
  @@index([categoria])
  @@index([cidade, estado])
  @@index([status])
  @@index([usuarioId])
}

model PerfilArtista {
  id            String      @id @default(uuid()) @db.Uuid
  tipo          TipoArtista
  nomeArtistico String      @db.VarChar(120)
  slug          String      @unique @db.VarChar(120)

  biografia   String?  @db.Text
  experiencia String?  @db.Text
  cache       Decimal? @db.Decimal(10, 2)

  fotoCapaUrl String? @db.VarChar(500)

  cidade String @db.VarChar(120)
  estado String @db.VarChar(2)
  pais   String @default("Brasil") @db.VarChar(80)

  instagramUrl String? @db.VarChar(500)
  facebookUrl  String? @db.VarChar(500)
  youtubeUrl   String? @db.VarChar(500)
  spotifyUrl   String? @db.VarChar(500)
  tiktokUrl    String? @db.VarChar(500)
  siteUrl      String? @db.VarChar(500)

  aceitaViagem Boolean @default(false)
  disponivel   Boolean @default(true)
  verificado   Boolean @default(false)

  visualizacoes        Int      @default(0)
  avaliacao            Decimal? @db.Decimal(2, 1)
  quantidadeAvaliacoes Int      @default(0)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuarioId String  @unique @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  instrumentos   ArtistaInstrumento[]
  generos        ArtistaGenero[]
  integrantes    IntegranteBanda[]
  portfolio      Portfolio[]
  solicitacoes   SolicitacaoContratacao[]
  agenda         AgendaArtista[]
  artistaFuncaos ArtistaFuncao[]
  avaliacoes     Avaliacao[]

  @@index([tipo])
  @@index([cidade, estado])
  @@index([disponivel])
  @@index([verificado])
  @@index([nomeArtistico])
  @@index([cache])
  @@index([avaliacao])
  @@index([visualizacoes])
}

model PerfilContratante {
  id              String   @id @default(uuid()) @db.Uuid
  nomeResponsavel String?  @db.VarChar(120)
  nomeEmpresa     String?  @db.VarChar(160)
  cidade          String?  @db.VarChar(120)
  estado          String?  @db.VarChar(2)
  criadoEm        DateTime @default(now())
  atualizadoEm    DateTime @updatedAt

  usuarioId String  @unique @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@index([cidade, estado])
  @@index([nomeEmpresa])
}

model Instrumento {
  id    String  @id @default(uuid()) @db.Uuid
  nome  String  @unique @db.VarChar(80)
  ativo Boolean @default(true)

  artistas ArtistaInstrumento[]

  @@index([ativo])
}

model ArtistaInstrumento {
  artistaId     String  @db.Uuid
  instrumentoId String  @db.Uuid
  principal     Boolean @default(false)

  artista     PerfilArtista @relation(fields: [artistaId], references: [id], onDelete: Cascade)
  instrumento Instrumento   @relation(fields: [instrumentoId], references: [id], onDelete: Cascade)

  @@id([artistaId, instrumentoId])
  @@index([artistaId])
  @@index([instrumentoId])
  @@index([principal])
}

model GeneroMusical {
  id    String  @id @default(uuid()) @db.Uuid
  nome  String  @unique @db.VarChar(80)
  ativo Boolean @default(true)

  artistas ArtistaGenero[]

  @@index([ativo])
}

model ArtistaGenero {
  artistaId String  @db.Uuid
  generoId  String  @db.Uuid
  principal Boolean @default(false)

  artista PerfilArtista @relation(fields: [artistaId], references: [id], onDelete: Cascade)
  genero  GeneroMusical @relation(fields: [generoId], references: [id], onDelete: Cascade)

  @@id([artistaId, generoId])
  @@index([artistaId])
  @@index([generoId])
  @@index([principal])
}

model Cidade {
  id   String @id @default(uuid()) @db.Uuid
  nome String @db.VarChar(120)
  uf   String @db.VarChar(2)

  @@unique([nome, uf])
  @@index([uf])
}

model IntegranteBanda {
  id           String            @id @default(uuid()) @db.Uuid
  nome         String            @db.VarChar(120)
  funcao       FuncaoIntegrante?
  outraFuncao  String?           @db.VarChar(80)
  instrumento  String?           @db.VarChar(80)
  telefone     String?           @db.VarChar(20)
  instagramUrl String?           @db.VarChar(500)
  fotoUrl      String?           @db.VarChar(500)
  ativo        Boolean           @default(true)
  criadoEm     DateTime          @default(now())
  atualizadoEm DateTime          @updatedAt

  bandaId String        @db.Uuid
  banda   PerfilArtista @relation(fields: [bandaId], references: [id], onDelete: Cascade)

  @@index([bandaId])
  @@index([ativo])
  @@index([funcao])
}

model FuncaoArtistica {
  id    String  @id @default(uuid()) @db.Uuid
  nome  String  @db.VarChar(80)
  ativo Boolean @default(true)

  artistas ArtistaFuncao[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([nome])
}

model ArtistaFuncao {
  artistaId String @db.Uuid
  funcaoId  String @db.Uuid

  artista PerfilArtista   @relation(fields: [artistaId], references: [id], onDelete: Cascade)
  funcao  FuncaoArtistica @relation(fields: [funcaoId], references: [id], onDelete: Cascade)

  principal Boolean @default(false)

  @@id([artistaId, funcaoId])
}

model Portfolio {
  id           String        @id @default(uuid()) @db.Uuid
  titulo       String?       @db.VarChar(160)
  descricao    String?       @db.Text
  arquivoUrl   String        @db.VarChar(500)
  miniaturaUrl String?       @db.VarChar(500)
  tipo         TipoPortfolio
  destaque     Boolean       @default(false)
  ordem        Int           @default(0)
  criadoEm     DateTime      @default(now())
  atualizadoEm DateTime      @updatedAt

  artistaId String        @db.Uuid
  artista   PerfilArtista @relation(fields: [artistaId], references: [id], onDelete: Cascade)

  @@index([artistaId])
  @@index([tipo])
  @@index([destaque])
  @@index([ordem])
  @@index([artistaId, ordem])
}

model SolicitacaoContratacao {
  id String @id @default(uuid()) @db.Uuid

  descricao  String      @db.Text
  tipoEvento TipoEvento?
  dataEvento DateTime?
  nomeLocal  String?     @db.VarChar(160)

  cidade   String  @db.VarChar(120)
  estado   String  @db.VarChar(2)
  endereco String? @db.VarChar(255)

  orcamento Decimal?          @db.Decimal(10, 2)
  status    StatusSolicitacao @default(PENDENTE)

  // How the show itself is structured — e.g. 2 sets of 1h30 with a 20min
  // break between them — instead of a single fixed-length block. Mirrors
  // how this is actually negotiated informally (WhatsApp groups, etc).
  numeroSets        Int @default(1)
  duracaoSetMinutos Int @default(120)
  intervaloMinutos  Int @default(0)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  contratanteId String  @db.Uuid
  contratante   Usuario @relation(fields: [contratanteId], references: [id], onDelete: Restrict)

  artistaId String        @db.Uuid
  artista   PerfilArtista @relation(fields: [artistaId], references: [id], onDelete: Restrict)

  agenda        AgendaArtista[]
  notificacoes  Notificacao[]
  avaliacao     Avaliacao?

  @@index([contratanteId])
  @@index([artistaId])
  @@index([status])
  @@index([tipoEvento])
  @@index([dataEvento])
  @@index([cidade, estado])
  @@index([artistaId, status])
  @@index([contratanteId, status])
}

model Avaliacao {
  id         String   @id @default(uuid()) @db.Uuid
  nota       Int
  comentario String?  @db.Text
  criadoEm   DateTime @default(now())

  solicitacaoId String                 @unique @db.Uuid
  solicitacao    SolicitacaoContratacao @relation(fields: [solicitacaoId], references: [id], onDelete: Cascade)

  artistaId String        @db.Uuid
  artista   PerfilArtista @relation(fields: [artistaId], references: [id], onDelete: Cascade)

  contratanteId String  @db.Uuid
  contratante   Usuario @relation(fields: [contratanteId], references: [id], onDelete: Cascade)

  @@index([artistaId])
  @@index([contratanteId])
}

model Denuncia {
  id           String         @id @default(uuid()) @db.Uuid
  tipo         TipoDenuncia
  motivo       MotivoDenuncia
  descricao    String?        @db.Text
  referenciaId String         @db.Uuid
  status       StatusDenuncia @default(PENDENTE)
  criadoEm     DateTime       @default(now())

  denuncianteId String  @db.Uuid
  denunciante   Usuario @relation(fields: [denuncianteId], references: [id], onDelete: Cascade)

  @@index([tipo])
  @@index([referenciaId])
  @@index([status])
  @@index([denuncianteId])
}

model AgendaArtista {
  id String @id @default(uuid()) @db.Uuid

  dataInicio DateTime
  dataFim    DateTime
  diaInteiro Boolean  @default(false)

  status StatusAgenda
  origem OrigemAgenda @default(ARTISTA)

  titulo     String? @db.VarChar(120)
  observacao String? @db.Text

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  artistaId String        @db.Uuid
  artista   PerfilArtista @relation(fields: [artistaId], references: [id], onDelete: Cascade)

  solicitacaoId String?                 @db.Uuid
  solicitacao   SolicitacaoContratacao? @relation(fields: [solicitacaoId], references: [id], onDelete: SetNull)

  @@index([artistaId])
  @@index([dataInicio])
  @@index([dataFim])
  @@index([status])
  @@index([origem])
  @@index([solicitacaoId])
  @@index([artistaId, dataInicio, dataFim])
  @@index([artistaId, status])
}

model Notificacao {
  id       String          @id @default(uuid()) @db.Uuid
  tipo     TipoNotificacao
  titulo   String          @db.VarChar(160)
  mensagem String          @db.Text
  lida     Boolean         @default(false)
  criadoEm DateTime        @default(now())

  usuarioId String  @db.Uuid
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  solicitacaoId String?                 @db.Uuid
  solicitacao   SolicitacaoContratacao? @relation(fields: [solicitacaoId], references: [id], onDelete: SetNull)

  conversaId String?   @db.Uuid
  conversa   Conversa? @relation(fields: [conversaId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([usuarioId, lida])
  @@index([criadoEm])
  @@index([conversaId])
}

model Conversa {
  id     String         @id @default(uuid()) @db.Uuid
  status StatusConversa @default(PENDENTE)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  anuncioId String  @db.Uuid
  anuncio   Anuncio @relation(fields: [anuncioId], references: [id], onDelete: Cascade)

  compradorId String  @db.Uuid
  comprador   Usuario @relation("ConversasComoComprador", fields: [compradorId], references: [id], onDelete: Cascade)

  vendedorId String  @db.Uuid
  vendedor   Usuario @relation("ConversasComoVendedor", fields: [vendedorId], references: [id], onDelete: Cascade)

  mensagens    Mensagem[]
  notificacoes Notificacao[]

  @@unique([anuncioId, compradorId])
  @@index([compradorId])
  @@index([vendedorId])
  @@index([status])
}

model Mensagem {
  id       String   @id @default(uuid()) @db.Uuid
  conteudo String   @db.Text
  lida     Boolean  @default(false)
  criadoEm DateTime @default(now())

  conversaId String   @db.Uuid
  conversa   Conversa @relation(fields: [conversaId], references: [id], onDelete: Cascade)

  autorId String  @db.Uuid
  autor   Usuario @relation(fields: [autorId], references: [id], onDelete: Cascade)

  @@index([conversaId])
  @@index([conversaId, criadoEm])
  @@index([autorId])
}
